# ==========================================
# KOS (Knowledge Operating System) Config
# ==========================================

# --- Firebase Auth & Firestore Client Config ---
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- BLUE AI (Gemini Provider - Server Side Only) ---
# NUNCA prefixe com VITE_ para evitar exposição no bundle do cliente!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_LIMIT_PER_DAY=100
